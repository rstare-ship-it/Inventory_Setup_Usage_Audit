# Inventory Setup/Usage Audit — Snowflake connector
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Used by: --from-snowflake and --tenant-group "T3 Services Group"
# The script loads .env automatically (python-dotenv) from this directory.

# Required for Snowflake
SNOWFLAKE_ACCOUNT=your_org.your_account
SNOWFLAKE_USER=your_email@company.com

# Region: omit for Okta/SSO in some orgs (404 if set). Use if your org requires it.
# SNOWFLAKE_REGION=us-west-2

# Auth: externalbrowser (Okta/SSO) or snowflake (password)
SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Optional: warehouse / database / schema / role (defaults from connection if omitted)
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_ROLE=

# Optional: override lookback for reports
# LOOKBACK_DAYS=90
